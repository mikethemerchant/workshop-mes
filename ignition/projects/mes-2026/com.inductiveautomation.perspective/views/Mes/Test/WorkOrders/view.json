        "transforms": [
          {
            "type": "script",
            "code": "\ttry:\n\t\treturn mes.ui.work_order_rows()\n\texcept:\n\t\timport sys\n\t\tmes.ui.log_once('work_order_rows', sys.exc_info()[1])\n\t\treturn []"
          }
        ]
      }
    },
    "custom.openRun": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\ttry:\n\t\treturn mes.ui.open_run_line()\n\texcept:\n\t\timport sys\n\t\tmes.ui.log_once('open_run_line', sys.exc_info()[1])\n\t\treturn 'error: %s' % sys.exc_info()[1]"
          }
        ]
