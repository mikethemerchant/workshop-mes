{
  "custom": {
    "window": 18,
    "nowLine": "",
    "totals": [],
    "events": []
  },
  "params": {},
  "props": {},
  "propConfig": {
    "custom.nowLine": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\ttry:\n\t\treturn mes.ui.downtime_now_line()\n\texcept:\n\t\timport sys\n\t\tmes.ui.log_once('downtime_now_line', sys.exc_info()[1])\n\t\treturn 'error: %s' % sys.exc_info()[1]"
          }
        ]
      }
    },
    "custom.totals": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "toMillis(now(2000)) + '|' + coalesce({view.custom.window}, 0)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\ttry:\n\t\tw = int(float(str(value).split('|')[1]))\n\t\treturn mes.ui.class_totals(w or None)\n\texcept:\n\t\timport sys\n\t\tmes.ui.log_once('class_totals', sys.exc_info()[1])\n\t\treturn []"
          }
        ]
      }
    },
    "custom.events": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "toMillis(now(2000)) + '|' + coalesce({view.custom.window}, 0)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\ttry:\n\t\tw = int(float(str(value).split('|')[1]))\n\t\treturn mes.ui.downtime_rows(w or None)\n\texcept:\n\t\timport sys\n\t\tmes.ui.log_once('downtime_rows', sys.exc_info()[1])\n\t\treturn []"
          }
        ]
      }
    }
  },
